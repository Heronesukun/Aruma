---
import Layout from "../layouts/Layout.astro";
import PostCard from "../components/PostCard.astro";
import Sidebar from "../components/Sidebar.astro";
import { i18n } from "../i18n/translation";
import I18nKey from "../i18n/i18nKey";
import { getPostDate, getVisiblePosts } from "../utils/post-list";

const allPosts = await getVisiblePosts();
const posts = allPosts.sort(
	(a, b) => getPostDate(b).valueOf() - getPostDate(a).valueOf(),
);

const groupedPosts = posts.reduce(
	(acc, post) => {
		const year = getPostDate(post).getFullYear();
		if (!acc[year]) acc[year] = [];
		acc[year].push(post);
		return acc;
	},
	{} as Record<number, typeof posts>,
);
const years = Object.keys(groupedPosts)
	.map(Number)
	.sort((a, b) => b - a);
---

<Layout title={i18n(I18nKey.archiveTitle)}>
	<div class="article">
		{
			years.map((year) => (
				<div class="archive-year-section" id={`year-${year}`}>
					<div class="mdui-card archive-card mdui-hoverable">
						<div class="archive-title">
							<span>
								{i18n(I18nKey.archiveYear).replace(
									"{year}",
									year.toString(),
								)}
							</span>
						</div>
					</div>
					{groupedPosts[year].map((post) => (
						<PostCard post={post} />
					))}
				</div>
			))
		}
	</div>

	<Sidebar slot="sidebar" />
</Layout>

<script>
	type ArchiveLifecycle = {
		applyFilter?: (hashOverride?: string) => void;
		pageLoadHandler?: () => void;
		hashChangeHandler?: () => void;
	};

	const archiveWindow = window as typeof window & {
		__arumaArchiveLifecycle?: ArchiveLifecycle;
		applyArchiveFilter?: (hashOverride?: string) => void;
	};
	const archiveLifecycle = (archiveWindow.__arumaArchiveLifecycle ??= {});

	const applyArchiveFilter = (hashOverride?: string) => {
		const hash = hashOverride || window.location.hash;
		const sections = document.querySelectorAll<HTMLElement>(
			".archive-year-section",
		);

		if (sections.length === 0) return;

		if (!hash || !hash.startsWith("#year-")) {
			sections.forEach((section) => {
				section.style.display = "";
			});
			// 如果没有指定年份，强制回到顶部
			requestAnimationFrame(() => {
				window.scrollTo(0, 0);
			});
			return;
		}

		const targetId = hash.slice(1);
		sections.forEach((section) => {
			section.style.display = section.id === targetId ? "" : "none";
		});

		// 过滤后也滚动到顶部，因为当前年份就是内容的开始了
		requestAnimationFrame(() => {
			window.scrollTo(0, 0);
		});
	};

	archiveLifecycle.applyFilter = applyArchiveFilter;
	// Expose a stable delegate for Drawer.astro to call.
	archiveWindow.applyArchiveFilter = (hashOverride?: string) =>
		archiveLifecycle.applyFilter?.(hashOverride);

	// 页面加载时处理（包括 View Transitions 导航）
	if (!archiveLifecycle.pageLoadHandler) {
		archiveLifecycle.pageLoadHandler = () =>
			archiveLifecycle.applyFilter?.();
		document.addEventListener(
			"astro:page-load",
			archiveLifecycle.pageLoadHandler,
		);
	}

	// 处理 hash 变化（同页面内切换年份）
	if (!archiveLifecycle.hashChangeHandler) {
		archiveLifecycle.hashChangeHandler = () =>
			archiveLifecycle.applyFilter?.();
		window.addEventListener(
			"hashchange",
			archiveLifecycle.hashChangeHandler,
		);
	}

	// 初始加载时也执行一次
	applyArchiveFilter();
</script>

<style>
	.archive-year-section {
		margin-bottom: 40px;
	}
</style>
