---
export const prerender = true;

import { type CollectionEntry, render } from "astro:content";
import BlogPost from "../../layouts/BlogPost.astro";
import { getPostDate, getVisiblePosts } from "../../utils/post-list";
import { getReadingStats } from "../../utils/reading-stats";

export async function getStaticPaths() {
	const posts = await getVisiblePosts();
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}
type Props = CollectionEntry<"post">;

const post = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(post);
const readingStats = getReadingStats(post.body ?? "");
const pubDate = getPostDate(post);
const heroImage = post.data.heroImage || post.data.image;
const hasMath = remarkPluginFrontmatter.hasMath === true;
---

<BlogPost
	title={post.data.title}
	description={post.data.description}
	pubDate={pubDate}
	updatedDate={post.data.updatedDate}
	heroImage={heroImage}
	tags={post.data.tags}
	category={post.data.category}
	author={post.data.author}
	id={post.id}
	hasMath={hasMath}
	searchIndex={!post.data.draft}
	wordCount={readingStats.wordCount}
	readingMinutes={readingStats.readingMinutes}
>
	<Content />
</BlogPost>
