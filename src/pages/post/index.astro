---
import Layout from "../../layouts/Layout.astro";
import Sidebar from "../../components/Sidebar.astro";
import { i18n } from "../../i18n/translation";
import PostCard from "../../components/PostCard.astro";
import I18nKey from "../../i18n/i18nKey";
import { getVisiblePosts, sortPostsForIndex } from "../../utils/post-list";

const allPosts = sortPostsForIndex(await getVisiblePosts());

// Pagefind is generated after `astro build`, so development uses this metadata
// as a graceful fallback while production searches the rendered article body.
const fallbackSearchData = allPosts.map((post) => ({
	url: `/post/${post.id}/`,
	searchText: [
		post.data.title,
		post.data.description,
		post.data.category,
		...(post.data.tags ?? []),
	]
		.filter(Boolean)
		.join(" "),
	description: post.data.description,
}));
const fallbackSearchJson = JSON.stringify(fallbackSearchData).replaceAll(
	"<",
	"\\u003c",
);
---

<Layout title={i18n(I18nKey.archive)}>
	<div class="article">
		<div
			id="search-header"
			class="mdui-card archive-card animation-fadein"
			style="display: none;"
			aria-live="polite"
		>
			<div class="archive-title">
				<i class="mdui-icon material-icons">search</i>
				{i18n(I18nKey.searchResult)}: <i id="search-query"></i>
				<span
					style="font-size: 14px; margin-left: 10px; opacity: 0.7;"
					set:html={i18n(I18nKey.foundPosts, { count: 0 }).replace(
						"0",
						'<span id="search-count">0</span>',
					)}
				/>
			</div>
		</div>

		<div
			id="posts-container"
			data-pagefind-enabled={import.meta.env.PROD ? "true" : "false"}
		>
			{allPosts.map((post) => <PostCard post={post} />)}
		</div>

		<div
			id="no-results"
			class="mdui-card archive-card animation-fadein"
			style="display: none; padding: 40px 20px;"
		>
			<div
				class="mdui-typo-display-1-opacity"
				style="text-align: center; margin-bottom: 20px;"
			>
				<i
					class="mdui-icon material-icons"
					style="font-size: 48px; opacity: 0.5;">find_in_page</i
				>
			</div>
			<div
				style="text-align: center; opacity: 0.7;"
				id="no-results-text"
				data-template={i18n(I18nKey.noSearchResult)}
			>
			</div>
			<div style="text-align: center; margin-top: 20px;">
				<a
					href="/post/"
					class="mdui-btn mdui-btn-raised mdui-ripple mdui-color-theme-accent"
				>
					{i18n(I18nKey.viewAllPosts)}
				</a>
			</div>
		</div>

		<script
			is:inline
			id="post-search-fallback-data"
			type="application/json"
			set:html={fallbackSearchJson}
		/>
	</div>

	<Sidebar slot="sidebar" />
</Layout>

<script>
	interface FallbackPost {
		url: string;
		searchText: string;
		description: string;
	}

	interface SearchHit {
		url: string;
		excerpt?: string;
	}

	interface PagefindResultData {
		url: string;
		excerpt?: string;
		plain_excerpt?: string;
	}

	interface PagefindApi {
		options(options: { excerptLength: number }): Promise<void>;
		search(
			query: string,
			options: { filters: { type: string } },
		): Promise<{
			results: Array<{
				data(): Promise<PagefindResultData>;
			}>;
		}>;
	}

	declare global {
		interface Window {
			__arumaPostSearchPageLoad?: EventListener;
			__arumaPostSearchRun?: number;
		}
	}

	let pagefindPromise: Promise<PagefindApi> | undefined;

	function normalizePath(url: string): string {
		let path = new URL(url, window.location.origin).pathname;
		try {
			path = decodeURIComponent(path);
		} catch {
			// Keep the encoded path when the URL contains malformed escapes.
		}
		return path.replace(/\/index\.html$/, "").replace(/\/+$/, "") || "/";
	}

	function readFallbackPosts(): FallbackPost[] {
		const data = document.getElementById("post-search-fallback-data");
		if (!data?.textContent) return [];
		try {
			return JSON.parse(data.textContent) as FallbackPost[];
		} catch (error) {
			console.warn("Unable to read the local search fallback.", error);
			return [];
		}
	}

	async function loadPagefind(): Promise<PagefindApi> {
		if (!pagefindPromise) {
			pagefindPromise = (async () => {
				// Pagefind writes this module after Astro has finished bundling.
				const bundlePath = "/pagefind/pagefind.js";
				const pagefind = (await import(
					/* @vite-ignore */ bundlePath
				)) as PagefindApi;
				await pagefind.options({ excerptLength: 32 });
				return pagefind;
			})().catch((error) => {
				pagefindPromise = undefined;
				throw error;
			});
		}
		return pagefindPromise;
	}

	function searchFallback(posts: FallbackPost[], query: string): SearchHit[] {
		const normalizedQuery = query.toLocaleLowerCase();
		return posts
			.filter((post) =>
				post.searchText.toLocaleLowerCase().includes(normalizedQuery),
			)
			.map((post) => ({
				url: post.url,
				excerpt: post.description,
			}));
	}

	async function searchArticles(query: string): Promise<SearchHit[]> {
		const pagefind = await loadPagefind();
		const response = await pagefind.search(query, {
			filters: { type: "post" },
		});
		const results = await Promise.all(
			response.results.map((result) => result.data()),
		);
		return results.map((result) => ({
			url: result.url,
			excerpt: result.excerpt ?? result.plain_excerpt,
		}));
	}

	function setSafeExcerpt(element: Element, excerpt: string): void {
		const source = document.createElement("template");
		source.innerHTML = excerpt;
		const output = document.createDocumentFragment();

		for (const node of source.content.childNodes) {
			if (node.nodeType === Node.TEXT_NODE) {
				output.append(node.cloneNode());
				continue;
			}
			if (node instanceof HTMLElement && node.tagName === "MARK") {
				const mark = document.createElement("mark");
				mark.textContent = node.textContent;
				output.append(mark);
				continue;
			}
			output.append(document.createTextNode(node.textContent ?? ""));
		}

		element.replaceChildren(output);
	}

	function createCardTemplates(
		container: HTMLElement,
	): Map<string, HTMLElement> {
		const templates = new Map<string, HTMLElement>();
		container
			.querySelectorAll<HTMLElement>("a.post[href]")
			.forEach((card) => {
				const href = card.getAttribute("href");
				if (href)
					templates.set(
						normalizePath(href),
						card.cloneNode(true) as HTMLElement,
					);
			});
		return templates;
	}

	function renderHits(
		container: HTMLElement,
		hits: SearchHit[],
		templates: Map<string, HTMLElement>,
	): number {
		const cards = hits.flatMap((hit) => {
			const template = templates.get(normalizePath(hit.url));
			if (!template) return [];

			const card = template.cloneNode(true) as HTMLElement;
			card.classList.add("search-result");
			const excerpt = card.querySelector(".index-subtitle");
			if (excerpt && hit.excerpt) setSafeExcerpt(excerpt, hit.excerpt);
			return [card];
		});

		container.replaceChildren(...cards);
		return cards.length;
	}

	async function initPostSearch(): Promise<void> {
		const container = document.getElementById("posts-container");
		const searchHeader = document.getElementById("search-header");
		const noResults = document.getElementById("no-results");
		const noResultsText = document.getElementById("no-results-text");
		const queryElement = document.getElementById("search-query");
		const countElement = document.getElementById("search-count");
		if (
			!container ||
			!searchHeader ||
			!noResults ||
			!noResultsText ||
			!queryElement ||
			!countElement
		) {
			return;
		}

		const query =
			new URLSearchParams(window.location.search).get("q")?.trim() ?? "";
		if (!query) return;

		const templates = createCardTemplates(container);
		const fallbackPosts = readFallbackPosts();
		const run = (window.__arumaPostSearchRun ?? 0) + 1;
		window.__arumaPostSearchRun = run;

		searchHeader.style.display = "block";
		queryElement.textContent = query;
		countElement.textContent = "…";
		noResults.style.display = "none";
		container.setAttribute("aria-busy", "true");

		let hits: SearchHit[];
		if (container.dataset.pagefindEnabled === "true") {
			try {
				hits = await searchArticles(query);
			} catch (error) {
				console.warn(
					"Full-text search is unavailable; using metadata fallback.",
					error,
				);
				hits = searchFallback(fallbackPosts, query);
			}
		} else {
			hits = searchFallback(fallbackPosts, query);
		}

		if (
			window.__arumaPostSearchRun !== run ||
			!container.isConnected ||
			new URLSearchParams(window.location.search).get("q")?.trim() !==
				query
		) {
			return;
		}

		const count = renderHits(container, hits, templates);
		countElement.textContent = String(count);
		container.removeAttribute("aria-busy");

		if (count === 0) {
			noResultsText.textContent = (
				noResultsText.dataset.template ?? 'No posts found for "{query}"'
			).replaceAll("{query}", query);
			noResults.style.display = "block";
		}
	}

	if (window.__arumaPostSearchPageLoad) {
		document.removeEventListener(
			"astro:page-load",
			window.__arumaPostSearchPageLoad,
		);
	}
	window.__arumaPostSearchPageLoad = () => void initPostSearch();
	document.addEventListener(
		"astro:page-load",
		window.__arumaPostSearchPageLoad,
	);

	if (document.readyState === "complete") {
		void initPostSearch();
	}
</script>

<style>
	.archive-card {
		margin-bottom: 20px;
		padding: 15px 0;
		text-align: center;
		background-color: rgba(255, 255, 255, 0.8);
		border-radius: 7px;
	}
	:global(.mdui-theme-layout-dark) .archive-card {
		background-color: rgba(66, 66, 66, 0.8);
		color: #fff;
	}
	:global(.mdui-theme-layout-dark) .archive-card i,
	:global(.mdui-theme-layout-dark) .archive-card div,
	:global(.mdui-theme-layout-dark) .archive-card a {
		color: #fff !important;
	}
	.archive-title {
		font-size: 20px;
		font-weight: 500;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
	}
	.archive-title i {
		font-style: normal;
		color: var(--color);
	}
	#posts-container {
		transition: opacity 0.2s ease;
	}
	#posts-container[aria-busy="true"] {
		opacity: 0.55;
		pointer-events: none;
	}
	:global(.index-subtitle mark) {
		border-radius: 2px;
		background: color-mix(in srgb, var(--color) 35%, transparent);
		color: inherit;
		padding: 0 2px;
	}
	:global(.search-result .index-subtitle) {
		display: -webkit-box;
		opacity: 0.9;
		max-height: 50px;
		transform: translateY(0);
		margin-top: 8px;
	}
</style>
