---
import { i18n } from "../i18n/translation";
import I18nKey from "../i18n/i18nKey";
---

<div
	class="mdui-textfield mdui-textfield-expandable appbar-search"
	id="search-container"
>
	<button
		class="mdui-textfield-icon mdui-btn mdui-btn-icon"
		id="open-search"
		type="button"
		aria-label="搜索文章"
		title="搜索文章"
	>
		<i class="mdui-icon material-icons">search</i>
	</button>
	<input
		class="mdui-textfield-input"
		type="text"
		id="search-input"
		placeholder={i18n(I18nKey.searchPlaceholder)}
		autocomplete="off"
	/>
</div>

<style>
	.appbar-search {
		position: relative;
		display: flex;
		align-items: center;
	}

	.appbar-search .mdui-textfield-input {
		color: var(--appbar-foreground);
		border-bottom: 1px solid var(--appbar-border);
		width: 0;
		transition: width 0.3s ease;
		background: transparent;
		border-top: none;
		border-left: none;
		border-right: none;
		padding: 8px 0;
		font-size: 16px;
		outline: none;
		box-shadow: none;
	}

	.appbar-search .mdui-textfield-input:focus {
		outline: none;
		box-shadow: none;
		border-bottom: 1px solid var(--appbar-foreground);
	}

	.appbar-search.mdui-textfield-expanded .mdui-textfield-input {
		width: 200px;
		border-bottom-color: var(--appbar-foreground);
	}

	.appbar-search .mdui-textfield-input::placeholder {
		color: var(--appbar-placeholder);
	}

	@media (max-width: 768px) {
		.appbar-search.mdui-textfield-expanded .mdui-textfield-input {
			width: 120px;
		}
	}

	@media (max-width: 480px) {
		:global(
			.mdui-toolbar:has(.appbar-search.mdui-textfield-expanded)
				.mdui-typo-title
		) {
			display: none;
		}

		.appbar-search.mdui-textfield-expanded .mdui-textfield-input {
			width: 100px;
		}
	}
</style>

<script>
	import { navigate } from "astro:transitions/client";

	type SearchLifecycle = {
		controller?: AbortController;
		init?: () => void;
		pageLoadHandler?: () => void;
	};

	const searchWindow = window as typeof window & {
		__arumaSearchLifecycle?: SearchLifecycle;
	};
	const searchLifecycle = (searchWindow.__arumaSearchLifecycle ??= {});

	function initSearch() {
		searchLifecycle.controller?.abort();
		const controller = new AbortController();
		const { signal } = controller;
		searchLifecycle.controller = controller;

		const searchContainer = document.getElementById("search-container");
		const openSearchBtn = document.getElementById("open-search");
		const searchInput = document.getElementById(
			"search-input",
		) as HTMLInputElement;

		if (!searchContainer || !openSearchBtn || !searchInput) return;

		const openSearch = () => {
			if (!searchContainer) return;
			searchContainer.classList.add("mdui-textfield-expanded");
			searchInput.value = "";
			searchInput.focus();
		};

		const closeSearch = () => {
			if (!searchContainer) return;
			searchContainer.classList.remove("mdui-textfield-expanded");
		};

		const performSearch = () => {
			const query = searchInput.value.trim();
			if (query) {
				navigate(`/post/?q=${encodeURIComponent(query)}`);
			}
		};

		openSearchBtn.addEventListener(
			"click",
			(e) => {
				e.stopPropagation();
				const hasContent = searchInput.value.trim().length > 0;
				if (
					searchContainer?.classList.contains(
						"mdui-textfield-expanded",
					) ||
					hasContent
				) {
					performSearch();
				} else {
					openSearch();
				}
			},
			{ signal },
		);

		searchInput.addEventListener("click", (e) => e.stopPropagation(), {
			signal,
		});
		searchInput.addEventListener(
			"keydown",
			(e) => {
				if (e.key === "Enter") {
					performSearch();
				}
			},
			{ signal },
		);

		document.addEventListener(
			"click",
			(e) => {
				const target = e.target as HTMLElement;
				if (
					searchContainer?.classList.contains(
						"mdui-textfield-expanded",
					) &&
					!searchContainer.contains(target)
				) {
					closeSearch();
				}
			},
			{ signal },
		);

		document.addEventListener(
			"keydown",
			(e) => {
				if (
					e.key === "Escape" &&
					searchContainer.classList.contains(
						"mdui-textfield-expanded",
					)
				) {
					closeSearch();
				}
			},
			{ signal },
		);

		document.addEventListener(
			"astro:before-swap",
			() => {
				controller.abort();
				if (searchLifecycle.controller === controller) {
					searchLifecycle.controller = undefined;
				}
			},
			{ once: true, signal },
		);

		const urlParams = new URLSearchParams(window.location.search);
		const queryParam = urlParams.get("q");
		if (queryParam && searchInput) {
			searchInput.value = queryParam;
			searchContainer.classList.add("mdui-textfield-expanded");
		}
	}

	searchLifecycle.init = initSearch;
	if (!searchLifecycle.pageLoadHandler) {
		searchLifecycle.pageLoadHandler = () => searchLifecycle.init?.();
		document.addEventListener(
			"astro:page-load",
			searchLifecycle.pageLoadHandler,
		);
	}
	searchLifecycle.init();
</script>
