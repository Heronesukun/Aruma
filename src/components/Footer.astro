---
import * as fs from "node:fs";
import * as path from "node:path";
import { siteConfig, footerConfig } from "../site.config";
import { getSocialIcon } from "../utils/icon-mapping";

const today = new Date();

let customFooterHtml = "";
if (footerConfig.enable) {
	if (footerConfig.customHtml && footerConfig.customHtml.trim() !== "") {
		customFooterHtml = footerConfig.customHtml.trim();
	} else {
		try {
			const footerConfigPath = path.join(
				process.cwd(),
				"src",
				"FooterConfig.html",
			);
			customFooterHtml = fs.readFileSync(footerConfigPath, "utf-8");
			customFooterHtml = customFooterHtml
				.replace(/<!--[\s\S]*?-->/g, "")
				.trim();
		} catch (error) {
			console.warn("FooterConfig.html file read failed:", error);
		}
	}
}
---

<footer class="footer-container mdui-typo">
	<div class="footer-text">
		&copy; {today.getFullYear()}
		{siteConfig.author}. All rights reserved.
		<br />
		Powered by <a href="https://astro.build" target="_blank">Astro</a> & <a
			href="https://github.com/Heronesukun/Aruma"
			target="_blank">Aruma</a
		>
	</div>

	{
		customFooterHtml && (
			<div class="footer-custom" set:html={customFooterHtml} />
		)
	}

	<div class="footer-social">
		{
			(siteConfig.profileCard?.social || []).map((link) => (
				<a
					href={link.url}
					target="_blank"
					rel="noopener noreferrer"
					class="mdui-btn mdui-btn-icon mdui-ripple"
					title={link.name}
					aria-label={link.name}
				>
					{link.icon === "github" ? (
						<svg
							class="social-icon"
							viewBox="0 0 24 24"
							fill="currentColor"
							aria-hidden="true"
						>
							<path d="M12 .297a12 12 0 0 0-3.793 23.385c.6.111.82-.261.82-.577v-2.234c-3.338.726-4.043-1.416-4.043-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.09-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.108-.775.418-1.305.762-1.605-2.665-.304-5.467-1.334-5.467-5.931 0-1.31.469-2.381 1.236-3.221-.124-.303-.536-1.524.117-3.176 0 0 1.008-.322 3.301 1.23a11.52 11.52 0 0 1 6.006 0c2.291-1.552 3.297-1.23 3.297-1.23.655 1.652.243 2.873.119 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.216.694.825.576A12.001 12.001 0 0 0 12 .297Z" />
						</svg>
					) : link.icon === "bilibili" ? (
						<svg
							class="social-icon"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="1.8"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<path d="m7 2 3 4m7-4-3 4" />
							<rect x="3" y="6" width="18" height="15" rx="4" />
							<path d="M8 11v3m8-3v3m-6 3h4" />
						</svg>
					) : (
						<i class="mdui-icon material-icons" aria-hidden="true">
							{getSocialIcon(link.icon)}
						</i>
					)}
				</a>
			))
		}
	</div>
</footer>

<style>
	.footer-container {
		width: 100%;
		background-color: rgba(255, 255, 255, 0.8);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		padding: 30px 0;
		text-align: center;
		margin-top: 40px;
		flex-shrink: 0;
		border-top: 1px solid rgba(0, 0, 0, 0.05);
	}
	:global(.mdui-theme-layout-dark) .footer-container {
		background-color: rgba(48, 48, 48, 0.8);
		color: rgba(255, 255, 255, 0.8);
		border-top-color: rgba(255, 255, 255, 0.05);
	}
	.footer-text {
		font-size: 14px;
		color: #666;
		margin-bottom: 15px;
		letter-spacing: 0.5px;
	}
	:global(.mdui-theme-layout-dark) .footer-text {
		color: rgba(255, 255, 255, 0.6);
	}
	.footer-custom {
		font-size: 14px;
		color: #666;
		margin-top: -15px;
		margin-bottom: 15px;
		letter-spacing: 0.5px;
	}
	:global(.mdui-theme-layout-dark) .footer-custom {
		color: rgba(255, 255, 255, 0.6);
	}
	.footer-custom a {
		color: #666;
		opacity: 0.8;
		transition: all 0.3s;
	}
	:global(.mdui-theme-layout-dark) .footer-custom a {
		color: rgba(255, 255, 255, 0.7);
	}
	.footer-custom a:hover {
		opacity: 1;
		color: var(--color);
	}
	.footer-social {
		display: flex;
		justify-content: center;
		gap: 15px;
	}
	.footer-social a {
		color: #666;
		opacity: 0.8;
		transition: all 0.3s;
	}
	.social-icon {
		width: 24px;
		height: 24px;
		vertical-align: middle;
	}
	:global(.mdui-theme-layout-dark) .footer-social a {
		color: rgba(255, 255, 255, 0.7);
	}
	.footer-social a:hover {
		opacity: 1;
		color: var(--color);
		transform: translateY(-2px);
	}
</style>
