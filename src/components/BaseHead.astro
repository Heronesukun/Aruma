---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import "../styles/global.css";
import type { ImageMetadata } from "astro";
import katexStylesheet from "katex/dist/katex.css?url";
import FallbackImage from "../assets/blog-placeholder-1.jpg";
import { SITE_TITLE } from "../consts";
import { siteConfig } from "../site.config";

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata | string;
	hasMath?: boolean;
	pageType?: "website" | "article";
	articleTitle?: string;
	publishedTime?: Date;
	modifiedTime?: Date;
	author?: string;
	tags?: string[];
	section?: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const {
	title,
	description,
	image,
	hasMath = false,
	pageType = "website",
	articleTitle,
	publishedTime,
	modifiedTime,
	author,
	tags = [],
	section,
} = Astro.props;

const imageValue = image ?? FallbackImage;
const imageSource =
	typeof imageValue === "string"
		? imageValue.trim() || FallbackImage.src
		: imageValue.src;
const imageURL = new URL(imageSource, Astro.site ?? Astro.url);
const isArticle = pageType === "article";
const publishedISOString = publishedTime?.toISOString();
const modifiedISOString = (modifiedTime ?? publishedTime)?.toISOString();
const articleJsonLd = isArticle
	? JSON.stringify({
			"@context": "https://schema.org",
			"@type": "BlogPosting",
			headline: articleTitle ?? title,
			description,
			image: imageURL.href,
			datePublished: publishedISOString,
			dateModified: modifiedISOString,
			inLanguage: siteConfig.lang,
			author: author
				? {
						"@type": "Person",
						name: author,
					}
				: undefined,
			keywords: tags.length > 0 ? tags : undefined,
			mainEntityOfPage: canonicalURL.href,
		}).replace(/</g, "\\u003c")
	: undefined;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" href="/favicon.ico" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL("rss.xml", Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<!-- Font preloads -->
<link
	rel="preload"
	href="/fonts/material-icons.woff2"
	as="font"
	type="font/woff2"
	crossorigin
/>
<link
	rel="preload"
	href="/fonts/ZenMaruGothic-Medium.ttf"
	as="font"
	type="font/ttf"
	crossorigin
/>
<link
	rel="preload"
	href="/fonts/loli.ttf"
	as="font"
	type="font/ttf"
	crossorigin
/>
<link
	rel="preload"
	href="/fonts/atkinson-regular.woff"
	as="font"
	type="font/woff"
	crossorigin
/>

<!-- KaTeX CSS is emitted by Vite and requested only by pages with formulas. -->
{hasMath && <link rel="stylesheet" href={katexStylesheet} />}

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={pageType} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content={siteConfig.lang.replace("-", "_")} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />
<meta property="og:image:alt" content={articleTitle ?? title} />

{
	isArticle && (
		<>
			{publishedISOString && (
				<meta
					property="article:published_time"
					content={publishedISOString}
				/>
			)}
			{modifiedISOString && (
				<meta
					property="article:modified_time"
					content={modifiedISOString}
				/>
			)}
			{author && <meta property="article:author" content={author} />}
			{section && <meta property="article:section" content={section} />}
			{tags.map((tag) => (
				<meta property="article:tag" content={tag} />
			))}
		</>
	)
}
{author && <meta name="author" content={author} />}

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={imageURL} />
<meta property="twitter:image:alt" content={articleTitle ?? title} />

{
	articleJsonLd && (
		<script type="application/ld+json" is:inline set:html={articleJsonLd} />
	)
}
