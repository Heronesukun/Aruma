<mdui-dropdown id="qrcode-dropdown" trigger="click" placement="bottom-end">
	<button
		class="mdui-btn mdui-btn-icon"
		slot="trigger"
		id="open-qrcode"
		type="button"
		aria-label="显示当前页面二维码"
		title="显示当前页面二维码"
	>
		<i class="mdui-icon material-icons">devices</i>
	</button>
	<div class="qrcode-container">
		<canvas id="qrcode-canvas" role="img" aria-label="当前页面二维码"
		></canvas>
	</div>
</mdui-dropdown>

<style>
	.qrcode-container {
		box-sizing: border-box;
		max-width: calc(100vw - 16px);
		padding: 12px;
		background: #fff;
		border: 3px solid var(--color, #ff4081);
		border-radius: 16px;
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
		display: flex;
		align-items: center;
		justify-content: center;
		opacity: 0;
		transform: translateY(-10px);
		pointer-events: none;
		transition:
			opacity 0.3s ease,
			transform 0.3s ease;
	}

	:global(.mdui-theme-layout-dark) .qrcode-container {
		background: #303030;
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
	}

	mdui-dropdown[open] .qrcode-container {
		opacity: 1;
		transform: translateY(0);
		pointer-events: auto;
	}

	#qrcode-canvas {
		display: block;
		background: #fff;
		border-radius: 8px;
		width: 180px;
		max-width: calc(100vw - 48px);
		height: auto;
		aspect-ratio: 1;
	}

	mdui-dropdown#qrcode-dropdown::part(panel) {
		background: transparent;
		box-shadow: none;
		max-width: calc(100vw - 16px);
		overflow: visible;
	}

	@media (max-width: 600px) {
		.qrcode-container {
			padding: 10px;
			border-width: 2px;
			border-radius: 14px;
		}

		#qrcode-canvas {
			width: min(168px, calc(100vw - 40px));
		}
	}
</style>

<script>
	async function initQRCode() {
		const qrcodeDropdown = document.getElementById(
			"qrcode-dropdown",
		) as any;
		const qrcodeCanvas = document.getElementById(
			"qrcode-canvas",
		) as HTMLCanvasElement;

		if (!qrcodeDropdown || !qrcodeCanvas) return;

		if (qrcodeDropdown.dataset.bound) return;
		qrcodeDropdown.dataset.bound = "true";

		qrcodeDropdown.addEventListener("open", async () => {
			try {
				const QRCode = await import("qrcode");
				const url = window.location.href;
				const isMobile = window.innerWidth <= 600;
				const availableWidth = window.innerWidth - (isMobile ? 40 : 48);
				const size = Math.max(
					128,
					Math.min(isMobile ? 168 : 180, availableWidth),
				);

				await (QRCode.default || QRCode).toCanvas(qrcodeCanvas, url, {
					width: size,
					margin: 4,
					errorCorrectionLevel: "M",
					color: {
						dark: "#000000",
						light: "#ffffff",
					},
				});

				// qrcode writes fixed inline dimensions; let the responsive CSS size it.
				qrcodeCanvas.style.removeProperty("width");
				qrcodeCanvas.style.removeProperty("height");
			} catch (error) {
				console.error("Failed to generate QR code:", error);
			}
		});
	}

	document.addEventListener("astro:page-load", initQRCode);
</script>
